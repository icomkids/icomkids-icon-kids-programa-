SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Exclusivamente no servidor. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=https://sistema.icomkids.com.br
PORT=3000
HOSTNAME=0.0.0.0
# Somente no servidor: JSON indexado pelo salesperson_id do vendedor.
# Cada entrada contém url HTTPS do servidor Uazapi, token da própria instância e phone com DDI/DDD.
ICOM_WHATSAPP_SELLERS=

# Assistente ICOM: somente no servidor. Não usar NEXT_PUBLIC_.
OPENAI_API_KEY=
# Opcional; padrão: gpt-realtime-2.1-mini.
OPENAI_REALTIME_MODEL=
# false desativa novas conversas; mantém as orientações rápidas.
ICOM_ASSISTANT_ENABLED=true
